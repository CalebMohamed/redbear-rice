#!/usr/bin/env bash

set -u

CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/weather-oracle/locations.conf"

if [[ ! -f "$CONFIG" ]]; then
    notify-send "Weather Oracle" "Missing $CONFIG"
    exit 1
fi

weather_description() {
    case "$1" in
        0) echo "Clear sky" ;;
        1) echo "Mainly clear" ;;
        2) echo "Partly cloudy" ;;
        3) echo "Overcast" ;;
        45|48) echo "Foggy" ;;
        51|53|55) echo "Drizzle" ;;
        56|57) echo "Freezing drizzle" ;;
        61|63|65) echo "Rain" ;;
        66|67) echo "Freezing rain" ;;
        71|73|75) echo "Snow" ;;
        77) echo "Snow grains" ;;
        80|81|82) echo "Rain showers" ;;
        85|86) echo "Snow showers" ;;
        95) echo "Thunderstorm" ;;
        96|99) echo "Thunderstorm with hail" ;;
        *) echo "Unknown" ;;
    esac
}

weather_icon() {
    case "$1" in
        0) echo "☀️" ;;
        1) echo "🌤️" ;;
        2) echo "⛅" ;;
        3) echo "☁️" ;;
        45|48) echo "🌫️" ;;
        51|53|55|56|57) echo "🌦️" ;;
        61|63|65|66|67|80|81|82) echo "🌧️" ;;
        71|73|75|77|85|86) echo "🌨️" ;;
        95|96|99) echo "⛈️" ;;
        *) echo "🌡️" ;;
    esac
}

while IFS='|' read -r name latitude longitude; do
    # Ignore comments and blank lines.
    [[ -z "$name" ]] && continue
    [[ "$name" == \#* ]] && continue

    response="$(
        curl -4 \
            --silent \
            --show-error \
            --fail \
            --connect-timeout 3 \
            --max-time 10 \
            "https://api.open-meteo.com/v1/forecast?latitude=${latitude}&longitude=${longitude}&daily=weather_code,temperature_2m_max,temperature_2m_min,precipitation_probability_max,precipitation_sum,sunrise,sunset&timezone=auto&forecast_days=1" \
            2>/dev/null
    )" || {
        notify-send \
            --app-name="Weather Oracle" \
            "Weather: $name" \
            "Failed to fetch forecast."
        continue
    }

    weather_code="$(jq -r '.daily.weather_code[0]' <<< "$response")"
    temp_min="$(jq -r '.daily.temperature_2m_min[0]' <<< "$response")"
    temp_max="$(jq -r '.daily.temperature_2m_max[0]' <<< "$response")"
    rain_probability="$(jq -r '.daily.precipitation_probability_max[0]' <<< "$response")"
    rain_amount="$(jq -r '.daily.precipitation_sum[0]' <<< "$response")"
    sunrise="$(jq -r '.daily.sunrise[0]' <<< "$response" | cut -d'T' -f2)"
    sunset="$(jq -r '.daily.sunset[0]' <<< "$response" | cut -d'T' -f2)"

    description="$(weather_description "$weather_code")"
    icon="$(weather_icon "$weather_code")"

    body="$(
        printf '%s\n\n%s°C – %s°C\nRain: %s%% · %s mm\n↑ %s  ↓ %s' \
            "$icon $description" \
            "$temp_min" \
            "$temp_max" \
            "$rain_probability" \
            "$rain_amount" \
            "$sunrise" \
            "$sunset"
    )"

    notify-send \
        --app-name="Weather Oracle" \
        --urgency=low \
        --expire-time=15000 \
        "$name" \
        "$body"

done < "$CONFIG"
