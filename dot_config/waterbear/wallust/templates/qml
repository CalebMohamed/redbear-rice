pragma Singleton
import QtQuick

QtObject {
  // semantic properties
  readonly property color background:    "{{ background }}"
  readonly property color backgroundAlt: "{{ background | lighten(0.05) }}"
  readonly property color surface:       "{{ background | lighten(0.10) }}"
  readonly property color text:          "{{ foreground }}"
  readonly property color textMuted:     "{{ foreground | darken(0.25) }}"
  readonly property color accent:        "{{ color4 }}"
  readonly property color urgent:        "{{ color11 }}"

  // dark colours
  readonly property color regular0: "{{ color0 }}"    // black
  readonly property color regular1: "{{ color1 }}"    // red
  readonly property color regular2: "{{ color2 }}"    // green
  readonly property color regular3: "{{ color3 }}"    // yellow
  readonly property color regular4: "{{ color4 }}"    // blue
  readonly property color regular5: "{{ color5 }}"    // magenta
  readonly property color regular6: "{{ color6 }}"    // cyan
  readonly property color regular7: "{{ color7 }}"    // white

  // light colours
  readonly property color bright0: "{{ color8 }}"     // bright black
  readonly property color bright1: "{{ color9 }}"     // bright red
  readonly property color bright2: "{{ color10 }}"    // bright green
  readonly property color bright3: "{{ color11 }}"    // bright yellow
  readonly property color bright4: "{{ color12 }}"    // bright blue
  readonly property color bright5: "{{ color13 }}"    // bright magenta
  readonly property color bright6: "{{ color14 }}"    // bright cyan
  readonly property color bright7: "{{ color15 }}"    // bright white
}

