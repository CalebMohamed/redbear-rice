#!/bin/bash

SOURCE_DIR="$HOME/pictures/wallpapers"
BLUR_DIR="$HOME/pictures/wallpapers-processed"
CURRENT="$HOME/.local/share/current_wallpaper"

blur-wallpapers

# Use explicitly supplied wallpaper, otherwise restore the previous one
if [ -n "$1" ]; then
    wallpaper="$SOURCE_DIR/$1"
    blurpaper="$BLUR_DIR/$1"
elif [ -L "$CURRENT" ] && [ -e "$CURRENT" ]; then
    blurpaper="$(readlink -f "$CURRENT")"
    wallpaper="$SOURCE_DIR/$(basename "$blurpaper")"
else
    wallpaper="$SOURCE_DIR/arch-desktop.jpg"
    blurpaper="$BLUR_DIR/arch-desktop.jpg"
    echo "no wallpaper selected and no previous wallpaper exists. (so defaulted to arch desktop)"
fi

pkill -x swaybg
swaybg -i "$blurpaper" -m fill > /dev/null 2>&1 &

ln -sf "$blurpaper" "$CURRENT"

echo "$wallpaper"
wallust run "$wallpaper"

# sends the reload signals to relevant programs
pkill -USR1 -x dwl
makoctl reload
qs ipc call shell reload
hyprctl reload

